// Esquema de PostgreSQL de Structunex. Sustituye a los modelos de Mongoose.
//
// Convenciones:
//  - Columnas en camelCase, igual que el JSON que viaja al frontend y al calc-service.
//  - Tablas con los mismos nombres que tenían las colecciones de Mongo (@@map).
//  - PK uuid v7 (ordenado por tiempo, como el ObjectId). En las 8 tablas del modelo
//    estructural la PK se llama `pk`, porque `id` ya es el id de dominio ("N1", "A1").
//    Hacia la API se sigue exponiendo como `_id` (ver src/lib/ids.js).
//  - `seq` (autoincremental) en las tablas del modelo: Postgres no garantiza el orden de
//    inserción al leer, y el frontend depende de él. Toda lectura ordena por `seq`.
//  - Lo que en Mongo eran subdocumentos o Mixed y nunca se consulta por dentro va en
//    columnas Json (JSONB): se guarda y se devuelve entero.
//  - Los "enums" son String validados por Zod en la ruta: añadir un valor no necesita
//    migración.

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // sin binario de Rust: usa @prisma/adapter-pg
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuarios (espejo de Clerk, rellenado por el webhook) ───
model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  clerkId           String    @unique // = ownerId de proyectos y catálogos
  email             String?
  firstName         String?
  lastName          String?
  imageUrl          String?
  mailchimpSyncedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

// ─── Catálogos del usuario (no ligados a un proyecto) ───
model CatalogMaterial {
  id          String   @id @default(uuid(7)) @db.Uuid
  ownerId     String // Clerk user id
  name        String
  type        String   @default("steel") // concrete | steel | rebar | other
  E           Float // kPa
  nu          Float
  density     Float? // kN/m³
  alpha       Float?
  fc          Float?
  fcExpected  Float?
  lightweight Boolean  @default(false)
  lambda      Float?
  Fy          Float?
  Fu          Float?
  Fye         Float?
  Fue         Float?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  frameSections CatalogFrameSection[]
  areaSections  CatalogAreaSection[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("catalog_materials")
}

model CatalogFrameSection {
  id            String   @id @default(uuid(7)) @db.Uuid
  ownerId       String
  name          String
  materialId    String   @db.Uuid
  propertyType  String   @default("steel") // steel | concrete | other
  source        String // catalog | parametric | general
  catalogLabel  String?
  shape         String?
  b             Float?
  h             Float?
  d             Float?
  t             Float?
  tw            Float?
  tf            Float?
  bf            Float?
  bfTop         Float?
  tfTop         Float?
  bfBot         Float?
  tfBot         Float?
  A             Float?
  I33           Float?
  I22           Float?
  J             Float?
  reinforcement Json? // armado (solo hormigón); su rebarMaterialId no lleva FK
  props         Json // { A, I33, I22, J } resueltas por el servidor
  modifiers     Json     @default("{}")
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Restrict: no se puede borrar un material que usa alguna sección (409).
  material CatalogMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  elements ModelElement[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("catalog_frame_sections")
}

model CatalogAreaSection {
  id                String   @id @default(uuid(7)) @db.Uuid
  ownerId           String
  name              String
  kind              String   @default("shell")
  shellType         String
  materialId        String   @db.Uuid
  materialAngle     Float    @default(0)
  thicknessMembrane Float // m
  thicknessBending  Float // m
  modifiers         Json     @default("{}")
  color             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  material CatalogMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  areas    ModelArea[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("catalog_area_sections")
}

// ─── Proyecto ───
model Project {
  id               String   @id @default(uuid(7)) @db.Uuid
  ownerId          String // Clerk user id
  name             String
  code             String   @default("E.030")
  status           String   @default("draft") // draft | solving | solved | error
  isLocked         Boolean  @default(false)
  analysisProgress Json?
  analysisError    String?
  designProgress   Json?
  designError      String?
  templateId       String?
  analysisType     String?
  dofPerNode       Int?
  params           Json?
  units            String?
  client           String?
  company          String?
  engineer         String?
  description      String?
  // Logo para portadas y encabezados de los reportes (clave S3, PNG/JPEG).
  logoKey          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  configuration   ModelConfiguration?
  nodes           ModelNode[]
  elements        ModelElement[]
  supports        ModelSupport[]
  loads           ModelLoad[]
  areas           ModelArea[]
  frameLoads      ModelFrameLoad[]
  areaLoads       ModelAreaLoad[]
  areaSprings     ModelAreaSpring[]
  analysisRuns    AnalysisRun[]
  designRuns      DesignRun[]
  aiConversations AiConversation[]
  connections     Connection[]
  reportExports   ReportExport[]
  reports         Report[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("projects")
}

// Configuración no geométrica del modelo: una fila por proyecto.
model ModelConfiguration {
  projectId             String   @id @db.Uuid
  gridSystem            Json?
  loadPatterns          Json     @default("[]")
  loadCombinations      Json     @default("[]")
  massSource            Json?
  modalCases            Json     @default("[]")
  diaphragms            Json     @default("[]")
  spectrumFunctions     Json     @default("[]")
  responseSpectrumCases Json     @default("[]")
  activeDofs            Json? // null = automático
  defaultFrameSectionId String?
  defaultAreaSectionId  String?
  designPreferences     Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("model_configuration")
}

// ─── Modelo estructural: 8 tablas con pk + seq ───
model ModelNode {
  pk        String   @id @default(uuid(7)) @db.Uuid
  seq       BigInt   @default(autoincrement())
  projectId String   @db.Uuid
  id        String // "N1", único por proyecto
  x         Float
  y         Float
  z         Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, id])
  @@index([projectId, seq])
  @@map("model_nodes")
}

model ModelElement {
  pk             String   @id @default(uuid(7)) @db.Uuid
  seq            BigInt   @default(autoincrement())
  projectId      String   @db.Uuid
  id             String
  nodeA          String
  nodeB          String
  frameSectionId String?  @db.Uuid
  roll           Float    @default(0)
  releases       Json? // { i: {...}, j: {...} }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SetNull: si se borra la sección del catálogo, la barra queda sin sección.
  frameSection CatalogFrameSection? @relation(fields: [frameSectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, id])
  @@index([projectId, seq])
  @@index([frameSectionId])
  @@map("model_elements")
}

model ModelSupport {
  pk        String   @id @default(uuid(7)) @db.Uuid
  seq       BigInt   @default(autoincrement())
  projectId String   @db.Uuid
  nodeId    String
  dx        Boolean  @default(false)
  dy        Boolean  @default(false)
  dz        Boolean  @default(false)
  rx        Boolean  @default(false)
  ry        Boolean  @default(false)
  rz        Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, nodeId])
  @@index([projectId, seq])
  @@map("model_supports")
}

model ModelLoad {
  pk          String   @id @default(uuid(7)) @db.Uuid
  seq         BigInt   @default(autoincrement())
  projectId   String   @db.Uuid
  nodeId      String
  loadPattern String
  fx          Float    @default(0)
  fy          Float    @default(0)
  fz          Float    @default(0)
  mx          Float    @default(0)
  my          Float    @default(0)
  mz          Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, seq])
  @@map("model_loads")
}

model ModelArea {
  pk             String   @id @default(uuid(7)) @db.Uuid
  seq            BigInt   @default(autoincrement())
  projectId      String   @db.Uuid
  id             String // "A1"
  nodeIds        String[]
  areaSectionId  String?  @db.Uuid
  mesh           Json? // { along12, along13 }
  localAxisAngle Float    @default(0)
  diaphragm      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  areaSection CatalogAreaSection? @relation(fields: [areaSectionId], references: [id], onDelete: SetNull)

  @@unique([projectId, id])
  @@index([projectId, seq])
  @@index([areaSectionId])
  @@map("model_areas")
}

model ModelFrameLoad {
  pk           String   @id @default(uuid(7)) @db.Uuid
  seq          BigInt   @default(autoincrement())
  projectId    String   @db.Uuid
  elementId    String
  loadPattern  String
  kind         String   @default("distributed") // distributed | point
  dir          String   @default("gravity") // gx | gy | gz | gravity | local1 | local2 | local3
  value        Float    @default(0) // puntual: fuerza; distribuida: fuerza/longitud al inicio
  value2       Float? // distribuida trapezoidal: fuerza/longitud al final (null = uniforme)
  dist         Float? // puntual: posición; distribuida: inicio (null = 0)
  dist2        Float? // distribuida: fin (null = final de la barra)
  distAbsolute Boolean  @default(false) // false = dist/dist2 relativas 0..1; true = metros desde I
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, seq])
  @@map("model_frame_loads")
}

model ModelAreaLoad {
  pk          String   @id @default(uuid(7)) @db.Uuid
  seq         BigInt   @default(autoincrement())
  projectId   String   @db.Uuid
  areaId      String
  loadPattern String
  dir         String   @default("gravity")
  value       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, seq])
  @@map("model_area_loads")
}

model ModelAreaSpring {
  pk        String   @id @default(uuid(7)) @db.Uuid
  seq       BigInt   @default(autoincrement())
  projectId String   @db.Uuid
  areaId    String
  stiffness Float    @default(0) // kN/m³
  resists   String   @default("compressionOnly")
  face      String   @default("bottom")
  outward   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, areaId])
  @@index([projectId, seq])
  @@map("model_area_springs")
}

// ─── Ejecuciones (lo pesado vive en S3 como Parquet) ───
model AnalysisRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  projectId     String    @db.Uuid
  status        String    @default("solving") // solving | solved | error | cancelled
  startedAt     DateTime  @default(now())
  solvedAt      DateTime?
  durationMs    Int?
  error         String?
  s3Prefix      String?
  schemaVersion Int?
  activeDofs    String[]
  notes         String[]
  cases         Json      @default("[]")
  counts        Json      @default("{}")
  modes         Json      @default("[]")
  mesh          Json      @default("{}")
  modeShapes    String?
  springs       String?
  bytes         BigInt    @default(0)
  summary       Json      @default("{\"perCase\":[],\"drift\":[],\"storyForces\":[]}")
  stories       Json      @default("[]")
  modelHash     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designRuns     DesignRun[]
  connectionRuns ConnectionRun[]

  @@index([projectId, startedAt(sort: Desc)])
  @@map("analysis_runs")
}

model DesignRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  projectId     String    @db.Uuid
  analysisRunId String    @db.Uuid
  status        String    @default("designing") // designing | done | error | cancelled
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  error         String?
  code          String?
  steelCode     String?
  combos        String[]
  s3Prefix      String?
  schemaVersion Int?
  files         Json      @default("{}")
  counts        Json      @default("{}")
  notes         String[]
  bytes         BigInt    @default(0)
  summary       Json      @default("{}")
  // Huella de combinaciones + preferencias con que se comprobó (lib/designInputs.js):
  // si cambian, la comprobación deja de ser vigente aunque el análisis lo sea.
  inputsHash    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt(sort: Desc)])
  @@index([analysisRunId])
  @@map("design_runs")
}

// ─── Asistente IA (conversaciones por proyecto) ───
model AiConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  ownerId   String // Clerk user id
  title     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    AiMessage[]
  attachments AiAttachment[]

  @@index([projectId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

// Un mensaje de la API de Claude tal cual (append-only: los bloques de thinking deben
// reenviarse sin tocar). Los adjuntos van como bloques {type:"attachment", attachmentId}
// y se rehidratan desde S3 al construir cada petición.
model AiMessage {
  id              String   @id @default(uuid(7)) @db.Uuid
  conversationId  String   @db.Uuid
  seq             Int      @default(autoincrement())
  role            String // user | assistant
  content         Json
  // Propuesta de cambios del turno (en el último mensaje del asistente) y su estado.
  changeset       Json?
  changesetStatus String? // pending | applied | discarded
  usage           Json?
  createdAt       DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, seq])
  @@map("ai_messages")
}

model AiAttachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @db.Uuid
  s3Key          String
  mime           String
  name           String
  size           Int
  uploaded       Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_attachments")
}

// ─── Conexiones de acero ───
//
// Una conexión es UN extremo de barra apoyado en un nudo (un shear tab por viga): por eso
// es única por (proyecto, nudo, barra apoyada). Nudo y barras se referencian por su id de
// dominio ("N12", "B7"), como el resto del modelo; si el modelo cambia y desaparecen, la
// conexión queda huérfana (lo detecta el servicio) en vez de borrarse en cascada.
//
// `params` lleva su propia versión (`paramsVersion`): placa, pernos, soldadura y
// distancias, en unidades base (m, kN). Un parámetro sin definir es null, y la
// comprobación (F3) lo trata como NO VERIFICABLE, nunca como un valor por defecto.

model Connection {
  id                 String   @id @default(uuid(7)) @db.Uuid
  projectId          String   @db.Uuid
  nodeId             String // id de dominio del nudo
  supportedElementId String // la barra apoyada (id de dominio)
  name               String
  typology           String // shear_tab
  code               String   @default("AISC360-16")
  method             String   @default("LRFD")
  paramsVersion      Int      @default(1)
  params             Json     @default("{}")
  status             String   @default("draft") // draft | checked (el resultado va en la última ConnectionRun)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members ConnectionMember[]
  runs    ConnectionRun[]

  @@unique([projectId, nodeId, supportedElementId])
  @@index([projectId, createdAt])
  @@map("connections")
}

model ConnectionMember {
  id           String @id @default(uuid(7)) @db.Uuid
  connectionId String @db.Uuid
  elementId    String // id de dominio de la barra
  end          String // A | B: qué extremo de la barra está en el nudo
  role         String // supported | supporting

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, elementId])
  @@map("connection_members")
}

// Una comprobación de una conexión (F3). Guarda TODO lo que la produjo —la copia de las
// entradas (fuerzas por combinación, geometría, materiales), su hash, la versión del
// motor y la norma— para que un resultado sea reproducible aunque el modelo cambie o el
// análisis de origen se pode (por eso analysisRunId es SetNull: el id también va en
// `inputs`).
model ConnectionRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  connectionId  String    @db.Uuid
  analysisRunId String?   @db.Uuid
  status        String    @default("done") // done | error
  engineVersion String
  code          String
  method        String
  inputsHash    String
  inputs        Json
  results       Json      @default("{}")
  schemaVersion Int       @default(1)
  error         String?
  createdAt     DateTime  @default(now())

  connection  Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  @@index([connectionId, createdAt(sort: Desc)])
  @@index([analysisRunId])
  @@map("connection_runs")
}

// Reporting (R1): un PDF exportado. Guarda el documento EXACTO que se paginó (con las
// instantáneas de cada ejecución), las ejecuciones de origen y la huella del PDF, para
// poder decir siempre de qué cálculos sale cada hoja.
model ReportExport {
  id              String   @id @default(uuid(7)) @db.Uuid
  projectId       String   @db.Uuid
  kind            String // connections | members | analysis | memoria
  title           String
  lang            String   @default("es")
  unitSystemId    String?
  status          String   @default("done") // done | error
  runIds          String[]
  document        Json
  documentHash    String
  s3Key           String?
  sha256          String?
  bytes           Int?
  pages           Int?
  rendererVersion String?
  error           String?
  // R4: el documento de Report Studio exportado (null en las exportaciones directas
  // del archivo). Sin FK: borrar el documento no borra el PDF ya emitido.
  reportId        String?  @db.Uuid
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([reportId])
  @@map("report_exports")
}

// R4: un documento de Report Studio. `document` es el formato propio v1 (el del
// frontend, model/document.ts): texto del autor + bloques técnicos con vínculo,
// instantánea y huella. `version` sirve de control de concurrencia optimista.
model Report {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  title     String
  lang      String   @default("es")
  document  Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions ReportRevision[]

  @@index([projectId, updatedAt(sort: Desc)])
  @@map("reports")
}

// Revisión con nombre: copia congelada del documento ("Rev. A — para revisión").
model ReportRevision {
  id           String   @id @default(uuid(7)) @db.Uuid
  reportId     String   @db.Uuid
  number       Int
  name         String
  document     Json
  documentHash String
  createdAt    DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, number])
  @@map("report_revisions")
}
