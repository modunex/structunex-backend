{
  "name": "structunex-backend",
  "version": "0.1.0",
  "description": "Express + PostgreSQL (Prisma) backend for Structunex - AI structural design MVP",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "users:backfill": "node scripts/backfill-users.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@clerk/express": "^2.1.43",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "svix": "^1.99.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "6.19.3"
  }
}
