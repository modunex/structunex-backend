# Server
PORT=4000

# PostgreSQL. Local: el contenedor de Docker del README. En Render: la
# "Internal Database URL" de la base (la pone el Blueprint, render.yaml).
# Para usar la base de Render DESDE EL PORTÁTIL: "External Database URL" +
# `?sslmode=verify-full` (Render exige TLS fuera de su red; sin él cierra la
# conexión con "Server has closed the connection") y tu IP pública añadida en
# Render → base → Access Control. Ojo: la CLI de Prisma (db:migrate/db:deploy/
# db:studio) solo lee .env, no .env.local.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/structunex
# Conexiones máximas del pool (opcional, por defecto 5).
# DATABASE_POOL_MAX=5

# Python calc microservice. En Render el Blueprint inyecta CALC_SERVICE_HOSTPORT en
# su lugar; CALC_SERVICE_URL, si existe, manda.
CALC_SERVICE_URL=http://localhost:8000

# CORS: frontend origin(s). Acepta una lista separada por comas.
# En producción por defecto usa https://app.structunex.com
# localhost se permite automáticamente en desarrollo.
CLIENT_ORIGIN=http://localhost:5173

# Clerk authentication (real values live in .env.local, written by `clerk init`)
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Signing secret of the Clerk webhook endpoint (Dashboard → Webhooks). Verifies
# the /api/webhooks/clerk deliveries.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Mailchimp (registered users are synced into the audience by the Clerk webhook)
# Server region is fixed to us20 in code (config/env.js), so no prefix var here.
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us20
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx

# S3 (resultados de análisis en Parquet)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Asistente IA: Claude en Amazon Bedrock (endpoint Mantle). Usa las credenciales
# AWS de arriba: el usuario de IAM necesita permiso para invocar el modelo en
# Bedrock y s3:PutObject/GetObject sobre ${AWS_S3_BUCKET}/chat/* (adjuntos del chat).
# El bucket necesita CORS que permita PUT desde el origen del frontend.
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# Región de Bedrock (por defecto, AWS_REGION).
# BEDROCK_REGION=eu-west-1
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
AI_EFFORT=medium
# AI_MAX_UPLOAD_MB=20
